+/// The static FFmpeg's libraries (MSVC, built by tools/build-static-ffmpeg.ps1) from `lib_dir`, linked into pg-video.
+/// Its link needs these Windows libraries: FFmpeg's .pc files don't list them (docs/STATIC_BUILD.md).
+fn link_static(lib_dir: &Path) {
+    println!("cargo::rustc-link-search=native={}", lib_dir.display());
+    for lib in ["avcodec", "avformat", "avutil", "swresample", "swscale"] {
+        println!("cargo::rustc-link-lib=static={lib}");
+    }
+    for lib in ["user32", "bcrypt"] {
+        println!("cargo::rustc-link-lib={lib}");
+    }
+}
