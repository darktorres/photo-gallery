// markdownlint config for docs/ and READMEs. Run from the repo root: markdownlint docs "**/README.md"
{
  "default": true,
  // Prose wraps near 100 columns and table rows are as long as their content.
  "MD013": false,
  // Tables use the compact "| a | b |" rows with a "|---|---|" delimiter row.
  "MD060": false
}
