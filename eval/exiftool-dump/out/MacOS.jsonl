{"fields":{"Name":"XAttrQuarantine","Notes":"\n            quarantine information for files downloaded from the internet.  May only be\n            deleted when writing\n        ","PrintConv":"\n            my @a = split /;/, $val;\n            $a[0] = 'Flags=' . $a[0];\n            $a[1] = 'set at ' . ConvertUnixTime(hex $a[1]);\n            $a[2] = 'by ' . $a[2];\n            return join ' ', @a;\n        ","PrintConvInv":"$val","Protected":1,"Writable":1,"WriteCheck":"\"May only delete this tag\"","WritePseudo":1},"id":"com.apple.quarantine","index":null,"kind":"tag","table":"Image::ExifTool::MacOS::XAttr"}
