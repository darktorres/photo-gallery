{"fields":{"Format":"int8u","Name":"AspectRatio","PrintConv":"\n            my $lo = ($val & 0x0f);\n            my $hi = ($val >> 4);\n            my $aspect;\n            if ($lo < 2) {\n                $aspect = '4:3';\n            } elsif ($lo == 4 or $lo == 5) {\n                $aspect = '16:9';\n            } else {\n                $aspect = 'Unknown';\n            }\n            if ($hi == 4) {\n                $aspect .= ' NTSC';\n            } elsif ($hi == 5) {\n                $aspect .= ' PAL';\n            }\n            return $aspect;\n        "},"id":"128","index":null,"kind":"tag","table":"Image::ExifTool::MOI::Main"}
