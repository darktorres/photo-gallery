__pycache__/
*.pyc
/target/
# The JPEG decoder comparison is its own workspace (eval/jpeg-decoders).
/eval/jpeg-decoders/target/
# Large outputs live on D:\PhotoGallery, never in the repo.
*.npy
# Written by cxx-qt-build on every UI build (points qmlls at target/).
.qmlls.ini
# Logs of the Playwright MCP browser.
.playwright-mcp/
# The fuzz targets (fuzz/, S-18.1): the crate's build output, and what the fuzzer finds (corpus, crashes).
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
