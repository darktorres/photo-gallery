{"kind":"table","module":"MacOS","name":"Image::ExifTool::MacOS::XAttr","special":{"GROUPS":{"0":"File","1":"MacOS","2":"Other"},"NOTES":"\n        XAttr tags are extracted using the \"xattr\" utility.  They are extracted if\n        any \"XAttr*\" tag or the MacOS group is specifically requested, or by setting\n        the API L<XAttrTags|../ExifTool.html#XAttrTags> option to 1 or the API L<RequestAll|../ExifTool.html#RequestAll> option to 2 or higher.\n        And they are extracted by default from MacOS \"._\" files when reading\n        these files directly.\n    ","SHORT_NAME":"MacOS::XAttr","TABLE_NAME":"Image::ExifTool::MacOS::XAttr","TAG_PREFIX":"MacOS_XAttr","VARS":{"ID_FMT":"none"},"WRITE_PROC":{"code":"&Image::ExifTool::DummyWriteProc"}}}
{"fields":{"ConvertBinary":1,"Name":"XAttrFinderInfo","PrintConv":"\n            $val =~ s/^('.*?') ('.*?') //s or return $val;\n            my ($type, $creator) = ($1, $2);\n            my ($flags, $y, $x, $exFlags, $putAway) = split ' ', $val;\n            my $label = ($flags >> 1) & 0x07;\n            my $flags = DecodeBits((($exFlags<<16) | $flags) & 0xfff1, {\n                0 => 'OnDesk',\n                6 => 'Shared',\n                7 => 'HasNoInits',\n                8 => 'Inited',\n                10 => 'CustomIcon',\n                11 => 'Stationery',\n                12 => 'NameLocked',\n                13 => 'HasBundle',\n                14 => 'Invisible',\n                15 => 'Alias',\n                # extended flags\n                22 => 'HasRoutingInfo',\n                23 => 'ObjectBusy',\n                24 => 'CustomBadge',\n                31 => 'ExtendedFlagsValid',\n            });\n            my $str = \"Type=$type Creator=$creator Flags=$flags Label=$label Pos=($x,$y)\";\n            $str .= \" Putaway=$putAway\" if $putAway;\n            return $str;\n        ","ValueConv":"\n            my @a = unpack('a4a4n3x10nx2N', $$val);\n            tr/\\0//d, $_=\"'${_}'\" foreach @a[0,1];\n            return \"@a\";\n        "},"id":"com.apple.FinderInfo","index":null,"kind":"tag","table":"Image::ExifTool::MacOS::XAttr"}
{"fields":{"Binary":1,"Name":"XAttrResourceFork"},"id":"com.apple.ResourceFork","index":null,"kind":"tag","table":"Image::ExifTool::MacOS::XAttr"}
{"fields":{"Groups":{"2":"Time"},"Name":"XAttrLastUsedDate","PrintConv":"$self->ConvertDateTime($val)","RawConv":"ConvertUnixTime(unpack(\"V\",$$val))"},"id":"com.apple.lastuseddate#PS","index":null,"kind":"tag","table":"Image::ExifTool::MacOS::XAttr"}
