{"fields":{"Groups":{"2":"Time"},"Name":"XAttrMDItemDownloadedDate"},"id":"com.apple.metadata:kMDItemDownloadedDate","index":null,"kind":"tag","table":"Image::ExifTool::MacOS::XAttr"}
